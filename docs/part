```mermaid
flowchart LR
  subgraph SOC["riscv_soc"]
    LOADER["Firmware loader<br/>prog_wr_* / load_done"]
    PRAM["prog_ram<br/>combinational read<br/>synchronous write"]

    subgraph CORE["riscv"]
      PC["pc_counter<br/>if_pc"]
      IFRESP["IF response registers<br/>PC + instruction + valid"]
      IFID["if2id<br/>fetch_pkt_t"]
      DEC["decode<br/>fields, immediates, controls"]
      RF["regfile<br/>2 read / 1 write<br/>WB bypass"]
      IDEX["id2ex<br/>id_ex_pkt_t"]
      EX["execute<br/>ALU · RV32M · branch<br/>CSR · trap metadata"]
      LSU["lsu<br/>address · alignment<br/>store lanes · load extension"]
      DRAM["data_ram<br/>synchronous read<br/>byte-lane write"]
      MERGE["Safe EX/LSU merge<br/>ex2wb_pkt_in_safe"]
      EXWB["ex2wb<br/>ex_wb_pkt_t"]
      WB["wb_stage<br/>final result mux"]
      CSR["csr_regfile<br/>WARL state · trap · MRET"]
      COMMIT["commit_o<br/>architectural retirement"]
      CTRL["core_ctrl<br/>stall · flush · pipe_kill"]
      HAZARD{"RAW cause<br/>ID uses EX destination"}
      TRAP{"WB trap event<br/>illegal · ECALL · EBREAK<br/>instruction/data misalignment"}
    end
  end

  LOADER -->|"prog_wr_en / addr / data"| PRAM
  LOADER -.->|"load_done gates cpu_rst_n"| PC

  PC -->|"instr_ren_o + instr_addr_o"| PRAM
  PRAM -->|"instr_rdata_i"| IFRESP
  IFRESP -->|"fetch_pkt_t"| IFID
  IFID --> DEC
  RF -->|"rs1 / rs2 data"| DEC
  DEC -->|"decoded id_ex_pkt_t"| IDEX

  IDEX --> EX
  IDEX --> LSU
  LSU -->|"req / we / wstrb / addr / wdata"| DRAM
  DRAM -->|"ram_rdata: one-cycle load response"| LSU
  EX -->|"result + redirect/trap metadata"| MERGE
  LSU -->|"mem_info + issued-request metadata"| MERGE
  MERGE --> EXWB
  EXWB --> WB
  LSU -->|"aligned load_data"| WB
  WB -->|"rd_we / rd_addr / rd_data"| RF
  EXWB --> COMMIT
  WB -->|"final register result"| COMMIT
  DRAM -->|"raw committed load data"| COMMIT

  EXWB -->|"CSR write / trap / MRET / instret"| CSR
  CSR -->|"CSR read + legality"| EX
  CSR -.->|"effective WB-to-EX CSR/mepc bypass"| EX

  DEC -.->|"ID valid, use_rs1/use_rs2, addresses"| HAZARD
  IDEX -.->|"EX valid, rd, rf.we"| HAZARD
  HAZARD -.->|"hold PC + IF/ID; bubble ID/EX"| CTRL

  EX -.->|"aligned branch, jump, or MRET redirect"| PC
  EX -.->|"flush_req; starts fetch_kill_q"| CTRL

  EXWB -.-> TRAP
  CSR -.->|"mtvec"| TRAP
  TRAP -.->|"trap redirect has priority"| PC
  TRAP -.->|"pipe_kill and trap entry"| CTRL

  CTRL -.->|"pc_stall"| PC
  CTRL -.->|"stall / flush"| IFID
  CTRL -.->|"stall / flush"| IDEX
  CTRL -.->|"ex_kill"| LSU
  CTRL -.->|"canonical bubble on kill"| MERGE
```
