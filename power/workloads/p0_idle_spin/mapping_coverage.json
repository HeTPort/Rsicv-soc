{
  "schema_version": 1,
  "reviewed": true,
  "policy": "REQ-P0-004 block-level alternative for p0_idle_spin",
  "rationale": "Direct RTL-SAIF names map about 5.5% of routed nets. Require clock, CPU and program-BRAM activity; cap LSU/data-BRAM signal rates at 0.001 MHz to allow only the START-marker transaction tail, with no sustained data work. Require inactive timer bus, UART, GPIO and divider; measured incidental combinational DSP switching is explicitly bridged.",
  "functional_log_required": [
    "[POWER-TB] CAPTURE: PASS",
    "[TB] RESULT: PASS",
    "[POWER-TB] Window cycles = 458759",
    "[POWER-TB] Retired instructions = 196611",
    "[POWER-TB] RESULT0 = 0"
  ],
  "required_blocks": [
    {"name": "core_clock", "pattern": "^u_soc/clk_core$", "sources": ["C"], "minimum_matches": 1, "minimum_active": 1},
    {"name": "spin_cpu_pipeline", "pattern": "^u_soc/u_riscv/(u_id2ex|u_ex2wb|u_regfile|u_pc_counter)/", "sources": ["S"], "minimum_matches": 128, "minimum_active": 16},
    {"name": "spin_program_bram_boundary", "pattern": "^u_soc/u_prog_ram/", "sources": ["S"], "minimum_matches": 12, "minimum_active": 5},
    {"name": "no_sustained_lsu_or_fabric_traffic", "pattern": "^u_soc/(u_riscv/u_lsu|u_data_fabric)/", "sources": ["S"], "minimum_matches": 16, "maximum_active": 12, "maximum_signal_rate_mhz": 0.001},
    {"name": "no_sustained_data_bram_traffic", "pattern": "^u_soc/u_data_target/", "sources": ["S"], "minimum_matches": 4, "maximum_active": 4, "maximum_signal_rate_mhz": 0.001},
    {"name": "divider_not_exercised", "pattern": "^u_soc/u_riscv/u_rv32m_unit/u_radix2_divider/", "sources": ["S"], "minimum_matches": 64, "maximum_active": 2},
    {"name": "routed_dsp_incidental_activity_bridge", "pattern": "^u_soc/u_riscv/.*/u_rv32m_mul_comb/", "sources": ["A"], "minimum_matches": 200, "minimum_active": 200, "bridge_group": "product_ext"},
    {"name": "idle_timer_bus_boundary", "pattern": "^u_soc/u_timer_target/", "sources": ["S"], "minimum_matches": 2, "maximum_active": 0},
    {"name": "idle_uart_boundary", "pattern": "^u_soc/u_uart_target/", "sources": ["S"], "minimum_matches": 32, "maximum_active": 0},
    {"name": "idle_gpio_boundary", "pattern": "^u_soc/u_gpio_target/", "sources": ["S"], "minimum_matches": 2, "maximum_active": 0}
  ]
}
