`verilator_config

// The monolithic package intentionally exposes definitions that a leaf-only
// lint scope cannot consume. Full-SoC lint remains responsible for consumers.
lint_off -rule UNUSEDPARAM -file "*/src/core/riscv_pkg.sv"
lint_off -rule SYMRSVDWORD -file "*/src/core/riscv_pkg.sv" -match "*Symbol matches C++ common word: 'interrupt'*"

// Unit-scope wildcard imports and DW parameter names are the established
// repository/Questa-2019-compatible source convention, not local ambiguity.
lint_off -rule IMPORTSTAR -file "*/src/core/rv32m_mul_comb.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/rv32m_unit.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/if2id.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/id2ex.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/ex2wb.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/decode.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/execute.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/lsu.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/retire_stage.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/csr_regfile.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/core_ctrl.sv"
lint_off -rule IMPORTSTAR -file "*/src/core/riscv.sv"
lint_off -rule VARHIDDEN -file "*/src/core/rv32m_mul_comb.sv" -match "*Declaration of signal hides declaration in upper scope: 'DW'*"
lint_off -rule VARHIDDEN -file "*/src/core/rv32m_unit.sv" -match "*Declaration of signal hides declaration in upper scope: 'DW'*"
lint_off -rule VARHIDDEN -file "*/src/core/radix2_divider.sv" -match "*Declaration of signal hides declaration in upper scope: 'DW'*"
lint_off -rule VARHIDDEN -file "*/src/core/pc_counter.sv" -match "*Declaration of signal hides declaration in upper scope: 'AW'*"
lint_off -rule VARHIDDEN -file "*/src/core/decode.sv"
lint_off -rule VARHIDDEN -file "*/src/core/execute.sv"
lint_off -rule VARHIDDEN -file "*/src/core/lsu.sv"
lint_off -rule VARHIDDEN -file "*/src/core/retire_stage.sv"
lint_off -rule VARHIDDEN -file "*/src/core/csr_regfile.sv"
lint_off -rule VARHIDDEN -file "*/src/core/regfile.sv" -match "*Declaration of signal hides declaration in upper scope: 'DW'*"
lint_off -rule VARHIDDEN -file "*/src/core/riscv.sv"

// Reviewed width/unused-bit findings. These bits do not participate in the
// RV32 result; waivers are deliberately signal- and file-specific.
lint_off -rule WIDTHEXPAND -file "*/src/core/radix2_divider.sv" -match "*iteration_q*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/radix2_divider.sv" -match "*remainder_work_q*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/rv32m_mul_comb.sv" -match "*product_ext*"

// Existing core-level warnings are retained as narrow baseline waivers until
// their owning interface is migrated; this prevents them from hiding new IDs.
lint_off -rule EOFNEWLINE -file "*/src/core/pc_counter.sv"
lint_off -rule EOFNEWLINE -file "*/src/core/regfile.sv"
lint_off -rule PINCONNECTEMPTY -file "*/src/core/riscv.sv" -match "*busy_o*"
lint_off -rule WIDTHEXPAND -file "*/src/core/csr_regfile.sv" -match "*MSTATUS_MPP_M*"
lint_off -rule UNUSEDPARAM -file "*/src/core/csr_regfile.sv" -match "*MSTATUS_MPP_HI*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/riscv.sv" -match "*rv32m_req_ready*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/riscv.sv" -match "*Bits of signal are not used: 'retire_redirect'[2:0]*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/execute.sv" -match "*pkt_exe_i*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/execute.sv" -match "*eff_addr*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/csr_regfile.sv" -match "*Bits of signal are not used: 'addr'*"
lint_off -rule UNUSEDSIGNAL -file "*/src/core/lsu.sv" -match "*pkt_ex_i*"
lint_off -rule UNOPTFLAT -file "*/src/core/retire_stage.sv" -match "*irq_eligible*"

// Full-SoC baseline conventions and reviewed parameter-width findings.
lint_off -rule IMPORTSTAR -file "*/src/bus/core_bus_data_ram.sv"
lint_off -rule IMPORTSTAR -file "*/src/bus/core_bus_default_target.sv"
lint_off -rule IMPORTSTAR -file "*/src/bus/soc_data_fabric.sv"
lint_off -rule IMPORTSTAR -file "*/src/periph/mtime_timer.sv"
lint_off -rule IMPORTSTAR -file "*/src/periph/core_bus_uart.sv"
lint_off -rule IMPORTSTAR -file "*/src/periph/core_bus_gpio.sv" -match "*Import::* in $unit scope may pollute global namespace*"
lint_off -rule IMPORTSTAR -file "*/src/riscv_soc.sv"
lint_off -rule VARHIDDEN -file "*/src/riscv_soc.sv"
lint_off -rule VARHIDDEN -file "*/src/mem/prog_ram.sv"
lint_off -rule VARHIDDEN -file "*/src/mem/data_ram.sv"
lint_off -rule VARHIDDEN -file "*/src/bus/core_bus_data_ram.sv"
lint_off -rule VARHIDDEN -file "*/src/bus/core_bus_default_target.sv"
lint_off -rule VARHIDDEN -file "*/src/bus/soc_data_fabric.sv"
lint_off -rule VARHIDDEN -file "*/src/periph/mtime_timer.sv"
lint_off -rule VARHIDDEN -file "*/src/periph/core_bus_uart.sv"
lint_off -rule VARHIDDEN -file "*/src/periph/core_bus_gpio.sv" -match "*Declaration of signal hides declaration in upper scope: 'AW'*"
lint_off -rule VARHIDDEN -file "*/src/periph/core_bus_gpio.sv" -match "*Declaration of signal hides declaration in upper scope: 'DW'*"
lint_off -rule EOFNEWLINE -file "*/src/periph/core_bus_gpio.sv"
lint_off -rule PINCONNECTEMPTY -file "*/src/riscv_soc.sv"
lint_off -rule WIDTHTRUNC -file "*/src/periph/uart_rx.sv" -match "*baud_count_q*"
lint_off -rule WIDTHEXPAND -file "*/src/periph/uart_tx.sv" -match "*baud_count_q*"
lint_off -rule WIDTHEXPAND -file "*/src/periph/mtime_timer.sv" -match "*tick_count_q*"
lint_off -rule WIDTHEXPAND -file "*/src/periph/core_bus_uart.sv" -match "*ptr*"
lint_off -rule WIDTHEXPAND -file "*/src/periph/core_bus_uart.sv" -match "*rx_count_q*"
lint_off -rule WIDTHEXPAND -file "*/src/mem/prog_ram.sv" -match "*word_addr*"
lint_off -rule UNUSEDSIGNAL -file "*/src/riscv_soc.sv" -match "*uart_tx_ready*"
lint_off -rule UNUSEDSIGNAL -file "*/src/riscv_soc.sv" -match "*uart_tx_busy*"
lint_off -rule UNUSEDSIGNAL -file "*/src/periph/core_bus_gpio.sv" -match "*merged_write_data*"
lint_off -rule UNUSEDSIGNAL -file "*/src/periph/core_bus_uart.sv" -match "*shifter_done*"
lint_off -rule UNUSEDSIGNAL -file "*/src/periph/core_bus_uart.sv" -match "*rx_receiver_busy*"
lint_off -rule UNUSEDSIGNAL -file "*/src/bus/core_bus_data_ram.sv" -match "*active_req*"
lint_off -rule UNUSEDPARAM -file "*/src/bus/core_bus_default_target.sv" -match "*Parameter is not used: 'AW'*"
lint_off -rule UNUSEDSIGNAL -file "*/src/bus/core_bus_default_target.sv" -match "*req_i*"
lint_off -rule UNUSEDSIGNAL -file "*/src/mem/data_ram.sv" -match "*addr_i*"
